# 统一文本换行：仓库与工作区均使用 LF（Win / Mac 来回改也不再出现整文件假 diff）
* text=auto eol=lf

# Windows 脚本在本地保留 CRLF，便于直接双击运行
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 明确按文本处理的常见源码/文档
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.mmd text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# 二进制（禁止换行转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
